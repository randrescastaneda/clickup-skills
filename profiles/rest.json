{
  "mcpServers": {
    "clickup_work": {
      "type": "stdio",
      "command": "cu-work",
      "args": [
        "mcp"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "clickup_rest": {
      "type": "stdio",
      "command": "clickup-rest-mcp",
      "env": {
        "CLICKUP_API_KEY": "${CLICKUP_API_KEY}",
        "CLICKUP_TEAM_ID": "${CLICKUP_TEAM_ID}"
      }
    }
  }
}
