{
  "mcpServers": {
    "clickup_work": {
      "type": "stdio",
      "command": "cu-work",
      "args": [
        "mcp"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "clickup_context": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@hauptsache.net/clickup-mcp@1.9.0"
      ],
      "env": {
        "CLICKUP_API_KEY": "${CLICKUP_API_KEY}",
        "CLICKUP_TEAM_ID": "${CLICKUP_TEAM_ID}",
        "CLICKUP_MCP_MODE": "read-minimal"
      }
    }
  }
}
